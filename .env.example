# LLM configuration: "mock" (offline deterministic mode) or "gemini" (live Gemini API)
LLM_MODE=

# Google AI Studio API key (required only when LLM_MODE=gemini)
GEMINI_API_KEY=

# Gemini model name (e.g. gemini-3.8-flash)
GEMINI_MODEL=

# PayPal configuration: "mock" (simulated orders) or "sandbox" (real PayPal Sandbox API)
PAYPAL_MODE=

# Must be https://api-m.sandbox.paypal.com (app refuses to start with any other URL)
PAYPAL_BASE_URL=

# PayPal Sandbox REST App credentials (required only when PAYPAL_MODE=sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Base URL where this app runs locally (used for PayPal return/cancel redirects)
APP_BASE_URL=

# SQLite database file path (defaults to mandate.db)
DB_PATH=

# Risk score threshold above or equal to which purchases are HELD (default 0.7)
RISK_THRESHOLD=

# Set to "true" to enable the Ledger Tamper Demo button (/api/dev/tamper/{seq})
DEV_MODE=
